-- ------------------------------
-- FUNCTIONS
-- ------------------------------

DEFINE FUNCTION fn::number_of_unfulfilled_orders() -> int { SELECT VALUE count() FROM ONLY order WHERE order_status NOTINSIDE ['processed', 'shipped'] GROUP ALL; } PERMISSIONS FULL;
DEFINE FUNCTION fn::pound_to_usd($price: number) -> float { $price * 1.26f } PERMISSIONS FULL;

-- ------------------------------
-- TABLE: order
-- ------------------------------

DEFINE TABLE order TYPE RELATION FROM person TO product SCHEMAFULL PERMISSIONS none;
DEFINE FIELD product_name 
    ON TABLE order 
    TYPE string;
DEFINE FIELD currency 
    ON TABLE order 
    TYPE string;
DEFINE FIELD price 
    ON TABLE order 
    TYPE number;
DEFINE FIELD quantity 
    ON TABLE order 
    TYPE number;
DEFINE FIELD colour 
    ON TABLE order
    TYPE string;
DEFINE FIELD size 
    ON TABLE order
    TYPE string;
DEFINE FIELD shipping_address 
    ON TABLE order 
    TYPE object FLEXIBLE;
DEFINE FIELD payment_method 
    ON TABLE order 
    TYPE string;
DEFINE FIELD order_status 
    ON TABLE order 
    TYPE string;
DEFINE FIELD id 
    ON TABLE order 
    TYPE string;
DEFINE FIELD time 
    ON TABLE order 
    TYPE object;
DEFINE FIELD time.created_at 
    ON TABLE order 
    TYPE datetime
    DEFAULT time::now();
DEFINE FIELD time.updated_at 
    ON TABLE order 
    TYPE datetime
    VALUE time::now();
DEFINE FIELD time.processed_at 
    ON TABLE order 
    TYPE option<datetime>;
DEFINE FIELD time.shipped_at 
    ON TABLE order 
    TYPE option<datetime>;

-- ------------------------------
-- TABLE: review
-- ------------------------------

DEFINE TABLE review TYPE RELATION FROM person TO product SCHEMAFULL PERMISSIONS none;
DEFINE FIELD id 
    ON TABLE review 
    TYPE string;
DEFINE FIELD rating 
    ON TABLE review 
    TYPE number 
    ASSERT $value > 0 AND $value < 6;
DEFINE FIELD review_text 
    ON TABLE review 
    TYPE string;
DEFINE FIELD time 
    ON TABLE review 
    TYPE object;
DEFINE FIELD time.created_at 
    ON TABLE review 
    TYPE datetime
    DEFAULT time::now();
DEFINE FIELD time.updated_at 
    ON TABLE review 
    TYPE datetime
    VALUE time::now();

-- ------------------------------
-- TABLE: avg_product_review
-- ------------------------------

DEFINE TABLE avg_product_review TYPE NORMAL SCHEMAFULL AS SELECT count() AS number_of_reviews, math::mean(<float> rating) AS avg_review, ->product.id AS product_id, ->product.name AS product_name FROM review GROUP BY product_id, product_name;
DEFINE FIELD avg_review 
    ON TABLE avg_product_review 
    TYPE number;
DEFINE FIELD id 
    ON TABLE avg_product_review 
    TYPE string;
DEFINE FIELD number_of_reviews 
    ON TABLE avg_product_review 
    TYPE number;
DEFINE FIELD product_id 
    ON TABLE avg_product_review 
    TYPE array<record<product>>;
DEFINE FIELD product_name 
    ON TABLE avg_product_review 
    TYPE array<string>;

-- ------------------------------
-- TABLE: monthly_sales
-- ------------------------------

DEFINE TABLE monthly_sales TYPE NORMAL SCHEMAFULL AS SELECT count() AS number_of_orders, time::format(time.created_at, '%Y-%m') AS month, math::sum(price * quantity) AS sum_sales, currency FROM order GROUP BY month, currency;
DEFINE FIELD id 
    ON TABLE monthly_sales 
    TYPE string;
DEFINE FIELD currency 
    ON TABLE monthly_sales 
    TYPE string;
DEFINE FIELD month 
    ON TABLE monthly_sales 
    TYPE string;
DEFINE FIELD number_of_orders 
    ON TABLE monthly_sales 
    TYPE number;
DEFINE FIELD sum_sales 
    ON TABLE monthly_sales 
    TYPE number;
-- ------------------------------
-- TABLE: address_history
-- ------------------------------

DEFINE TABLE address_history TYPE NORMAL SCHEMAFULL PERMISSIONS none;
DEFINE FIELD id 
    ON TABLE address_history 
    TYPE string;
DEFINE FIELD person 
    ON TABLE address_history 
    TYPE record<person> REFERENCE;
DEFINE FIELD addresses
    ON TABLE address_history
    TYPE array<{
        address_line_1: string,
        address_line_2: option<string>,
        city: string,
        coordinates: geometry<point>,
        country: string,
        post_code: string
    }>;
DEFINE FIELD time 
    ON TABLE address_history 
    TYPE object;
DEFINE FIELD time.created_at 
    ON TABLE address_history 
    TYPE datetime
    DEFAULT time::now();
DEFINE FIELD time.updated_at 
    ON TABLE address_history 
    TYPE datetime
    VALUE time::now();

-- ------------------------------
-- TABLE: payment_details
-- ------------------------------

// Return to SCHEMAFULL after array<object> FLEXIBLE bug is fixed
DEFINE TABLE payment_details TYPE NORMAL PERMISSIONS none;
DEFINE FIELD id 
    ON TABLE payment_details 
    TYPE string;
DEFINE FIELD person 
    ON TABLE payment_details 
    TYPE record<person> REFERENCE;
DEFINE FIELD stored_cards 
    ON TABLE payment_details 
    TYPE array<object>; // FLEXIBLE;
DEFINE FIELD time 
    ON TABLE payment_details 
    TYPE object;
DEFINE FIELD time.created_at 
    ON TABLE payment_details 
    TYPE datetime
    DEFAULT time::now();
DEFINE FIELD time.updated_at 
    ON TABLE payment_details 
    TYPE datetime
    VALUE time::now();

-- ------------------------------
-- TABLE: person
-- ------------------------------

DEFINE TABLE person TYPE NORMAL SCHEMAFULL PERMISSIONS none;
DEFINE FIELD id 
    ON TABLE person 
    TYPE string;
DEFINE FIELD first_name 
    ON TABLE person 
    TYPE string;
DEFINE FIELD last_name 
    ON TABLE person 
    TYPE string;
DEFINE FIELD name 
    ON TABLE person 
    TYPE string;
DEFINE FIELD company_name 
    ON TABLE person 
    TYPE option<string>;
DEFINE FIELD email 
    ON TABLE person 
    TYPE string 
    ASSERT string::is_email($value);
DEFINE FIELD phone 
    ON TABLE person 
    TYPE string;
DEFINE FIELD address 
    ON TABLE person 
    TYPE object FLEXIBLE;
DEFINE FIELD time 
    ON TABLE person 
    TYPE object;
DEFINE FIELD time.created_at 
    ON TABLE person 
    TYPE datetime
    DEFAULT time::now();
DEFINE FIELD time.updated_at 
    ON TABLE person 
    TYPE datetime
    VALUE time::now();

-- ------------------------------
-- TABLE: product
-- ------------------------------

DEFINE TABLE product TYPE NORMAL SCHEMAFULL PERMISSIONS none;
DEFINE FIELD id 
    ON TABLE product 
    TYPE string;
DEFINE FIELD name 
    ON TABLE product 
    TYPE string;
DEFINE FIELD details 
    ON TABLE product 
    TYPE array<string>;
DEFINE FIELD category 
    ON TABLE product 
    TYPE string;
DEFINE FIELD sub_category 
    ON TABLE product 
    TYPE string;
DEFINE FIELD colours 
    ON TABLE product 
    TYPE array<string>;
DEFINE FIELD sizes 
    ON TABLE product 
    TYPE array<string>;
DEFINE FIELD price 
    ON TABLE product 
    TYPE number;
DEFINE FIELD currency 
    ON TABLE product 
    TYPE string;
DEFINE FIELD images 
    ON TABLE product 
    TYPE array<object>;
DEFINE FIELD images.*.url 
    ON TABLE product 
    TYPE string
    ASSERT string::is_url($value);
DEFINE FIELD images.*.position 
    ON TABLE product 
    TYPE number;
DEFINE FIELD seller 
    ON TABLE product 
    TYPE record<seller>;
DEFINE FIELD time 
    ON TABLE product 
    TYPE object;
DEFINE FIELD time.created_at 
    ON TABLE product 
    TYPE datetime
    DEFAULT time::now();
DEFINE FIELD time.updated_at 
    ON TABLE product 
    TYPE datetime
    VALUE time::now();


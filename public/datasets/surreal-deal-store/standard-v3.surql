INSERT RELATION INTO review [{ id: review:01FTGMG9AR86C9SNZ6YWDXRZWV, in: person:01H1J0N07G987AEFNZX45Q1EMF, out: product:01FYKKV9VG8CVBECBAQX01WKD8, rating: 4, review_text: "I've been using this tote bag for work and it's perfect for carrying my lunch, water bottle, and other essentials.", time: { created_at: d'2023-12-03T00:03:13Z', updated_at: d'2023-09-01T23:04:01Z' } }, { id: review:01FVTWXZ2G88SAZZ5PY89M4KNH, in: person:01GRTGJGW88F9B3926GG5NS1TX, out: product:01H15QWVJ881Y88BH5V9QF8X7X, rating: 5, review_text: "I've been searching for a great wool-like jacket for ages, and SurrealDB finally delivered! This one is perfect for the office or just running errands.", time: { created_at: d'2023-10-27T02:09:50Z', updated_at: d'2023-12-24T03:45:12Z' } }, { id: review:01FW1PAMBG8PKVN6R14BRFVG72, in: person:01GF2QJKJ89NRVFMYAZ6BMRM3W, out: product:01FYKKV9VG8CVBECBAQX01WKD8, rating: 5, review_text: "This tote bag is perfect for daily use. It's sturdy, spacious, and the design is really cute.", time: { created_at: d'2023-02-10T04:42:35Z', updated_at: d'2023-06-10T13:17:19Z' } }, { id: review:01FWVX8YCG969S2J4YDG2GVNBG, in: person:01H8PZ9QH88M3SCQAPPJGFA807, out: product:01H37CVZ2G95NB89AQKSV1NRGA, rating: 5, review_text: "I've been wearing this hoodie to work and it's been a game-changer. It's so comfortable and the zip-through design makes it easy to adjust the temperature.", time: { created_at: d'2023-12-10T10:34:39Z', updated_at: d'2023-10-11T07:10:30Z' } }, { id: review:01FX4XWHEG86ER2XRTZBR6N6Z9, in: person:01G6V3YAPG9B19N31JP6FNRB39, out: product:01GBE3CTMG93XBKM07CFH1S9S6, rating: 4, review_text: 'The quality of this hoodie is top-notch. The Heather Grey color is really sharp too.', time: { created_at: d'2023-02-03T02:19:42Z', updated_at: d'2023-07-08T02:37:37Z' } }, { id: review:01FX5P5RHG8CQR4KTQCFXN3HME, in: person:01GNT63AS083EA87C72AR0WRYZ, out: product:01H15QWVJ881Y88BH5V9QF8X7X, rating: 5, review_text: "I've worn this jacket to work, out with friends, and even just lounging around the house. It's perfect for any occasion!", time: { created_at: d'2023-12-04T23:38:46Z', updated_at: d'2023-10-25T03:07:21Z' } }, { id: review:01FX81QAV88CWTVEXH03SM8WXJ, in: person:01H5EPKP088WQSJGZB81K9RPWY, out: product:01H35P394G93AVCEF8KX59H5RY, rating: 4, review_text: "The pink color of this hoodie is so unique and eye-catching. It's perfect for making a statement.", time: { created_at: d'2023-12-27T17:11:28Z', updated_at: d'2023-03-15T13:37:06Z' } }, { id: review:01FX9M8AZR9BV8GKKN7VDDPHJ2, in: person:01HAQA9XD88T7AE0859QK39P1R, out: product:01HJN9QPNG9JAAAV19FT3GKZP0, rating: 4, review_text: "My kid has been wearing their Mini Cruiser Hoodie every day since I got it. It's really comfortable and the pink color is so cute.", time: { created_at: d'2023-07-17T09:10:56Z', updated_at: d'2023-11-12T23:10:04Z' } }, { id: review:01FXF5H95G828S7TRNSA40F8MM, in: person:01HJNVZ0P089MBNY4V5SWBW35B, out: product:01GE6EBV1G9QSVBR630TB0P1WT, rating: 4, review_text: 'This vest top is a great addition to my wardrobe. The pink color is really cute and it goes well with jeans.', time: { created_at: d'2023-06-29T21:59:23Z', updated_at: d'2023-03-21T06:26:47Z' } }, { id: review:01FXGG1MDG8J6B9XEQBQNYE3XG, in: person:01H52T5DTR9XPBQ1SQEPP5JASC, out: product:01H10G6EYR9J8A15EKJ5M4MY7Q, rating: 5, review_text: "I've worn this dress multiple times already and get tons of compliments. The material is also really comfortable.", time: { created_at: d'2023-04-09T04:40:40Z', updated_at: d'2023-04-11T13:09:02Z' } }, { id: review:01FXK56GPR9CSTD55N651QCVR7, in: person:01GV9PTB989J38HB3PWQMS7JEF, out: product:01GP683V1R8DTVN0KY3DWATDNR, rating: 4, review_text: 'This polo is a great addition to my wardrobe. The pink color adds a pop of fun to any outfit.', time: { created_at: d'2023-10-15T16:57:24Z', updated_at: d'2023-07-20T23:09:31Z' } }, { id: review:01FXNDZ2C893992S408TX4MYYQ, in: person:01H2FDNPNR8AHAVT0YD9C1485A, out: product:01GQ0ZTN1R8RVTM83RWN44T536, rating: 4, review_text: 'The Heather Grey Pink color is really pretty and the material feels soft.', time: { created_at: d'2023-07-22T02:48:42Z', updated_at: d'2023-07-22T02:48:42Z' } }, { id: review:01FXTHZ8RG8B580YQ5J2Q6NX6W, in: person:01GEGEFC0G9FR83Y55S1JNQ5EE, out: product:01GP683V1R8DTVN0KY3DWATDNR, rating: 4, review_text: "The fit of this polo is perfect. It's not too tight or too loose.", time: { created_at: d'2023-11-06T01:42:25Z', updated_at: d'2023-03-24T01:08:32Z' } }, { id: review:01FXVE5WHR81483NE2FGNCT1EQ, in: person:01FRKH70H88YXRSK4RQBN73P2D, out: product:01G7X22D188KQSZ2EZ73RTQDT8, rating: 4, review_text: 'This hoodie is great for casual days or running errands. The pink color adds a fun touch to any outfit.', time: { created_at: d'2023-09-19T00:49:13Z', updated_at: d'2023-06-01T12:27:24Z' } }, { id: review:01FXYPMCGG8V7V9X695TCV1CB1, in: person:01HJHC18WR8Y1RM63DBJTFXYR5, out: product:01H15QWVJ881Y88BH5V9QF8X7X, rating: 4, review_text: 'I love that this jacket has a bit of texture to it - it adds some visual interest. The color is also really pretty.', time: { created_at: d'2023-07-04T16:22:05Z', updated_at: d'2023-02-02T01:56:46Z' } }, { id: review:01FYBZTNW89J1VR6A61WVGC7ER, in: person:01H7V9M2XG9PYR9YCDH59PJQF0, out: product:01H37CVZ2G95NB89AQKSV1NRGA, rating: 5, review_text: "I've been wearing this hoodie to run errands and it's been a lifesaver. It's so comfortable and the fit is great.", time: { created_at: d'2023-11-28T00:42:45Z', updated_at: d'2023-07-13T02:43:49Z' } }, { id: review:01FYF7HNWG97GACWVTYV16M6YQ, in: person:01GK4TEXGG9Y3T6H7422AC91SN, out: product:01GFPN9YQ88QBRPEK7K2DZK486, rating: 4, review_text: "The fit on this bodywarmer is perfect - it's not too tight or too loose. The material is also really breathable.", time: { created_at: d'2023-06-12T02:02:50Z', updated_at: d'2023-07-04T09:26:38Z' } }, { id: review:01FYH31CTR9ET8RBN082SWZ7JD, in: person:01GJ9EX45R8MWSWKRFHAQNW75J, out: product:01G0MW4VTG8QZR3A4BTEXHXWS7, rating: 5, review_text: "This dress is perfect for my busy lifestyle. It's easy to throw on and go.", time: { created_at: d'2023-02-17T16:22:52Z', updated_at: d'2023-05-23T12:11:37Z' } }, { id: review:01FYQ6G09G848AWVNZMZ8SYMB0, in: person:01H79RAP8R99D848HVTS2VW6TV, out: product:01GP683V1R8DTVN0KY3DWATDNR, rating: 5, review_text: 'This polo is my new favorite! The fit is great, the material is soft and comfortable, and the pink color is gorgeous.', time: { created_at: d'2023-08-19T16:25:35Z', updated_at: d'2023-11-25T05:17:44Z' } }, { id: review:01FYW20J9G8B5T2BPZDSPZ8JJE, in: person:01HJ0P80A086BSSX0W815TA9A1, out: product:01HBKKCQYR9MAS0BNNT6DD13X3, rating: 5, review_text: "The Voyager Wool-Like Jacket has become my new go-to for cold winter days. It's that good!", time: { created_at: d'2023-05-12T13:00:35Z', updated_at: d'2023-10-10T05:53:26Z' } }, { id: review:01FZ0QV2408WDAR5FDGWNZ5XNR, in: person:01G7JSPVTG8J48NHS378VTH7NE, out: product:01GG2HYE3R8K9AM46AWAHHHP5K, rating: 5, review_text: 'I love that SurrealDB offers a range of colors - the Heather Grey one is really versatile.', time: { created_at: d'2024-01-14T10:20:18Z', updated_at: d'2024-01-14T10:20:18Z' } }, { id: review:01FZ92SHG08DYBJY9GXAB0DFEX, in: person:01GGQQ9NH89WJVRGGZN6H6N5NB, out: product:01G93Q42809S2A2DT08N3F2GBG, rating: 5, review_text: 'I was a bit hesitant to spend money on a hoodie online, but this one is worth it. The material is great and the Heather Grey color goes with everything.', time: { created_at: d'2023-11-25T03:10:17Z', updated_at: d'2024-01-06T10:39:02Z' } }, { id: review:01FZD0V7M09CEVYYTXECJ1R5KA, in: person:01G705Z0VG8THS6WH6H24QHXKG, out: product:01GRNCF5X88S29K4QQYNTYWDJF, rating: 4, review_text: "I've never seen anything like this design before - it's so unique and cool.", time: { created_at: d'2023-08-05T13:11:33Z', updated_at: d'2023-12-27T20:32:41Z' } }, { id: review:01FZQA63RG9F8RETW89CN8XM94, in: person:01GBGG6XT89VTSRY90MVXMK749, out: product:01HGAR7A0R9BETTCMATM6SSXPT, rating: 4, review_text: "I've had this jacket for a few weeks now and I'm really impressed with how well it's held up. The grey color is nice and neutral, too.", time: { created_at: d'2023-05-28T22:09:22Z', updated_at: d'2024-01-26T15:43:25Z' } }, { id: review:01FZZS6W2R8WVB0W592HJ8HPXY, in: person:01H5P9DGRR8VST8FD0B0PC22NB, out: product:01HGAR7A0R9BETTCMATM6SSXPT, rating: 4, review_text: "I've worn this jacket on hikes, to work, and even just lounging around. The grey color is really easy to match with other pieces.", time: { created_at: d'2023-07-09T05:35:32Z', updated_at: d'2023-07-07T14:35:54Z' } }, { id: review:01G01C48PR8JPSVQ4K8TXCNAMW, in: person:01H9M72VNR8Y1TJR2H2PXDP1H9, out: product:01G1ZZ2ZYR9JYRV8005YE84QGC, rating: 5, review_text: "I love how comfortable SurrealDB's Women's Coach in Black Pink is - I can wear it all day without feeling like I'm suffocating.", time: { created_at: d'2023-12-29T18:34:38Z', updated_at: d'2023-09-02T04:02:15Z' } }, { id: review:01G0Q6X0N099QSQCWP2YQQ6NMJ, in: person:01G8Z7FY2G8M5BY4MX7P3CB2KD, out: product:01GGAKS7G88M2SX7692GSVAB4Q, rating: 4, review_text: 'I love the subtle texture of this shirt. It adds a nice touch to any outfit.', time: { created_at: d'2023-06-21T18:21:20Z', updated_at: d'2023-11-14T03:08:51Z' } }, { id: review:01G0SWX7Y89QTTZPPBT9Z77DG5, in: person:01HCSH4H088QR94KST9352M8NW, out: product:01GRPEB3ER9249HAYQ0H4FEJRT, rating: 5, review_text: "I'm obsessed with this jacket! The grey color is perfect for my style and the fit is amazing. It's also super easy to care for - just toss it in the washing machine.", time: { created_at: d'2023-11-11T11:24:40Z', updated_at: d'2023-09-04T23:41:13Z' } }, { id: review:01G0SZT5JG98G8GK8MCRZCPNF9, in: person:01GG7306808J5RVG74CWNKYYZA, out: product:01HDY2QTTR82XS8PADHDTPEFYA, rating: 5, review_text: "This sweatshirt is perfect for casual days or layering under jackets. The fit is great, not too tight or loose. I love the Dark Heather Grey Pink color, it's really unique.", ti
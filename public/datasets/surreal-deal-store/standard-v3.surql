roduct:01FZ0CR6N09V5RG9RQ9A3264GX, rating: 5, review_text: "I'm so impressed with this sweatshirt! The quality is top-notch and the price is really affordable.", time: { created_at: d'2025-11-06T11:21:55Z', updated_at: d'2025-11-06T11:21:55Z' } }, { id: review:01J9QFF8W09TTTW6AFX3GJ3K5R, in: person:01GN32QJF893192S9XE59CJEQE, out: product:01GRTTE7DG94R864R67MGDT0QM, rating: 4, review_text: "I love that the Dark Heather Grey hoodie doesn't shrink or lose its shape after washing.", time: { created_at: d'2025-03-10T02:37:31Z', updated_at: d'2025-03-10T02:37:31Z' } }, { id: review:01J9ZSBNDR834VYFY5DKMGET05, in: person:01GCBW1Q7R8JFB9WH055048VZG, out: product:01FSXKCPVR8G1TVYFT4JFJS5WB, rating: 5, review_text: "I'm obsessed with this shirt! The purple and white color combo is stunning. I've worn it to work and received so many compliments.", time: { created_at: d'2025-03-04T08:52:46Z', updated_at: d'2025-10-20T15:19:24Z' } }, { id: review:01JA6V4TG89MMRXTCFBJBB4TTH, in: person:01G8B20NAG8899NGFJEGQZ34AK, out: product:01G93Q42809S2A2DT08N3F2GBG, rating: 4, review_text: "I've been wearing this hoodie for weeks and it still looks brand new. The Dark Heather Grey Pink color is really eye-catching too.", time: { created_at: d'2024-11-22T03:50:17Z', updated_at: d'2025-03-12T07:27:39Z' } }, { id: review:01JAETJE5G9ETA99BF12YXMMA2, in: person:01GYFNNDJR9MFA71PMABAWHHC7, out: product:01GQ0ZTN1R8RVTM83RWN44T536, rating: 5, review_text: "I've been wearing this sweatshirt nonstop since I got it. It's perfect for lounging around or running errands.", time: { created_at: d'2025-06-18T18:15:42Z', updated_at: d'2025-06-18T18:15:42Z' } }, { id: review:01JAG1ATHR83E9S9QGX2J5QP0J, in: person:01GSV75KQ89CE8R98BC4STEQAQ, out: product:01FSXKCPVR8G1TVYFT4JFJS5WB, rating: 5, review_text: "The combination of colors on this shirt is genius! I got the Heather Grey Pink color and it's perfect for casual days.", time: { created_at: d'2025-02-21T22:34:05Z', updated_at: d'2025-03-23T15:01:42Z' } }, { id: review:01JAH0FF4888FA3EKV94ZQ3QQ8, in: person:01GAH3Q0B889ZRFQ429RMZTWAF, out: product:01GXRS3FZG8Y8SDBNHMC14N25X, rating: 5, review_text: "This wool-like bodywarmer has been a game-changer for me. It's so warm and comfortable, I can focus on my climbing instead of worrying about the cold.", time: { created_at: d'2025-02-07T23:17:43Z', updated_at: d'2025-01-17T01:08:08Z' } }, { id: review:01JAN8YH7892Z9P6MPVYPCYQSM, in: person:01GB91M3BR9ZMSR6JB403DM5Q7, out: product:01H37CVZ2G95NB89AQKSV1NRGA, rating: 4, review_text: 'I was impressed by how well-made this hoodie is. The Heather Grey color is really nice and the zip-through design is convenient.', time: { created_at: d'2025-03-24T18:31:22Z', updated_at: d'2025-04-21T01:05:06Z' } }, { id: review:01JAXEHYZ0967VQG3Z4TR4Q91H, in: person:01GJ4K3G4G8BQRJZSNE1RTTX6B, out: product:01H10G6EYR9J8A15EKJ5M4MY7Q, rating: 5, review_text: "This dress is perfect for a day out with friends or just running errands. It's comfortable and easy to wear.", time: { created_at: d'2025-07-25T21:57:17Z', updated_at: d'2025-05-14T17:57:20Z' } }, { id: review:01JB3N28D09ZPVF0JQZ9G9P54P, in: person:01FRY7NN9G863SVCQH6VDYHSRP, out: product:01G93Q42809S2A2DT08N3F2GBG, rating: 4, review_text: 'This hoodie is so comfortable! I love the relaxed fit and the Dark Heather Grey Pink color is really unique.', time: { created_at: d'2025-09-26T18:39:04Z', updated_at: d'2024-11-12T02:32:27Z' } }, { id: review:01JB5Y8FJG9GE9YMQJY1E3F01R, in: person:01GH5PSRPG877RJ0SE4HCK1HKJ, out: product:01HJN9QPNG9JAAAV19FT3GKZP0, rating: 4, review_text: "My kid has been wearing their Mini Cruiser Hoodie to school every day. It's really comfortable and the Heather Grey color is nice.", time: { created_at: d'2025-08-21T13:05:25Z', updated_at: d'2025-01-08T08:45:18Z' } }, { id: review:01JBKA6DM88X4BZZXG3ZN12N7F, in: person:01GR16FWF09K0BK4TADCEYE3H0, out: product:01GP683V1R8DTVN0KY3DWATDNR, rating: 5, review_text: 'This polo is a great way to add some color to my wardrobe. The pink color is so bright and cheerful.', time: { created_at: d'2024-12-24T00:18:39Z', updated_at: d'2025-02-15T20:18:28Z' } }, { id: review:01JC3FR6688029CQXYPGZRZ7VV, in: person:01FXYV1N0R9Y8R2ZSW69AK8S5H, out: product:01FYKKV9VG8CVBECBAQX01WKD8, rating: 4, review_text: "I like that the tote bag is easy to clean and maintain - it's a great choice for someone who likes to keep their belongings organized.", time: { created_at: d'2025-10-31T01:33:13Z', updated_at: d'2025-05-14T20:05:40Z' } }, { id: review:01JCCPCR208P6TWVK8N78KDFH6, in: person:01FS6XF36R8739R70G7KS2730P, out: product:01G7X22D188KQSZ2EZ73RTQDT8, rating: 5, review_text: 'This hoodie has become my go-to for chilly mornings and evenings.', time: { created_at: d'2024-12-23T11:40:19Z', updated_at: d'2025-01-10T07:58:26Z' } }, { id: review:01JCJBYAA09D4S3WC25P45JVWK, in: person:01GBHW6HRG9JVTYDMF9KCHKJ69, out: product:01GBE3CTMG93XBKM07CFH1S9S6, rating: 5, review_text: 'The material of this hoodie is really soft and comfortable.', time: { created_at: d'2025-08-11T12:26:27Z', updated_at: d'2025-10-20T15:21:36Z' } }, { id: review:01JCK453908G7V1KPP4JD3HY0J, in: person:01G292NVV8894R188B1H48731T, out: product:01GXRS3FZG8Y8SDBNHMC14N25X, rating: 4, review_text: "This bodywarmer has become my new favorite piece of climbing gear. It's warm, comfortable, and looks great too.", time: { created_at: d'2025-05-06T01:59:50Z', updated_at: d'2025-09-28T01:14:38Z' } }, { id: review:01JCV6JAGG89NVYCNTZ3B8EGWM, in: person:01FW1RVJ6G8CQTQ7M5M3V1KSPB, out: product:01GG2HYE3R8K9AM46AWAHHHP5K, rating: 4, review_text: 'I was a bit worried about the fit, but this sweatshirt fits me perfectly. The Heather Grey color is really nice.', time: { created_at: d'2025-10-16T08:58:50Z', updated_at: d'2025-10-16T08:58:50Z' } }, { id: review:01JD4KXNDR971RFRA2WRVGP1KF, in: person:01GVYVWDQR8TBBDWCBG85K4ZDE, out: product:01GE6EBV1G9QSVBR630TB0P1WT, rating: 5, review_text: "I've been wearing this vest top nonstop since I got it. The pink color is my new favorite.", time: { created_at: d'2025-11-13T13:27:21Z', updated_at: d'2025-07-06T23:51:20Z' } }, { id: review:01JDAYHEW0811VTQ7KVFC4XPVV, in: person:01HF1SPT80946SPVXH1WJQZ9BM, out: product:01FSXKCPVR8G1TVYFT4JFJS5WB, rating: 5, review_text: 'This shirt is a must-have for anyone who loves surrealism. The design is incredible.', time: { created_at: d'2025-07-10T02:15:36Z', updated_at: d'2025-07-21T16:17:15Z' } }, { id: review:01JE8TWAVR8RARV0N1ZDJGVZHF, in: person:01HHBPJ1NG8JCA9MVFCY3Q3T6B, out: product:01GG2HYE3R8K9AM46AWAHHHP5K, rating: 4, review_text: "The Heather Grey color is really nice - it's not too light or too dark. I've worn it with white pants and it looks great.", time: { created_at: d'2025-09-23T16:42:55Z', updated_at: d'2025-09-23T16:42:55Z' } }] RETURN NONE;


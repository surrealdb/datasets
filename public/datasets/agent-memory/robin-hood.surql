INSERT INTO attribute {"id": attribute:`ib2dtw4f1vzb3az9tl74`, "key": "physical_description", "value": "stout of sinew and bold of heart", "memoryCategory": "identity", "importance": 1.0, "validUntil": "2000-01-02T00:00:00+00:00", "supersededBy": "d5ddecjela7e1widk4ds", "createdAt": "2000-01-01T00:00:00+00:00", "source": "How Robin Hood Came to Be an Outlaw", "entity": entity:["person", "robin_hood"]};
INSERT INTO attribute {"id": attribute:`ibf7532htaiveqcmr6pi`, "key": "possession", "value": "a half score or more of bags", "memoryCategory": "identity", "importance": 1.0, "validUntil": "2000-01-17T00:00:00+00:00", "supersedes": "di5bq9yhxvgucgqmwy7u", "supersededBy": "x298o7923lqetvmxmsd3", "createdAt": "2000-01-17T00:00:00+00:00", "source": "Robin Hood Turns Beggar", "entity": entity:["person", "robin"]};
INSERT INTO attribute {"id": attribute:`icw3ewqcqem05uc5d880`, "key": "opinion_of_losing_land", "value": "It is not mine own lot that doth trouble me in that case, but my dear lady's; for should I lose my land she will have to betake herself to some kinsman and there abide in charity, which, methinks, would break her proud heart.", "memoryCategory": "knowledge", "importance": 0.7200699422985956, "createdAt": "2000-01-14T00:00:00+00:00", "source": "Robin Hood Aids a Sorrowful Knight", "entity": entity:["person", "sir_richard"]};

INSERT INTO attribute {"id": attribute:`i98hjo2jwdjfv63cjteb`, "key": "opinion_of_fellow", "value": "A murrain seize him and his buffeting! I would that I had taken my dues from thee, for I verily believe he hath deafened mine ear from ever hearing again.", "memoryCategory": "knowledge", "importance": 0.7200699422985956, "createdAt": "2000-01-21T00:00:00+00:00", "source": "King Richard Comes to Sherwood Forest", "entity": entity:["person", "robin"]};

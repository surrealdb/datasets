CREATE attribute:⟨i6k6kgf1bdwg1y7ehw53⟩ CONTENT {"key": "personality", "value": "always had a taking way with the womenfolk", "memoryCategory": "knowledge", "importance": 0.7200699422985956, "supersedes": "mhp5785dxtc08a8ibm87", "createdAt": "2000-01-19T00:00:00+00:00", "source": "The Chase of Robin Hood", "entity": entity:["person", "little_john"]};
CREATE attribute:⟨i98hjo2jwdjfv63cjteb⟩ CONTENT {"key": "opinion_of_fellow", "value": "A murrain seize him and his buffeting! I would that I had taken my dues from thee, for I verily believe he hath deafened mine ear from ever hearing again.", "memoryCategory": "knowledge", "importance": 0.7200699422985956, "createdAt": "2000-01-21T00:00:00+00:00", "source": "King Richard Comes to Sherwood Forest", "entity": entity:["person", "robin"]};

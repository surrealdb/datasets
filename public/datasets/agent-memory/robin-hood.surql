INSERT INTO attribute {"id": attribute:`i1zhjugil5qxm8zpfal3`, "key": "opinion_of_sturdy_rogues", "value": "better safe in the prisons or dancing upon nothing, with a hempen collar about the neck, than strolling the highways so freely", "memoryCategory": "knowledge", "importance": 0.7200699422985956, "createdAt": "2000-01-17T00:00:00+00:00", "source": "Robin Hood Turns Beggar", "entity": entity:["person", "corn_engrosser"]};

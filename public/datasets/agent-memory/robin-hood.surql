CREATE attribute:⟨idulpenxvrqswoaj8l08⟩ CONTENT {"key": "temperament", "value": "raging", "memoryCategory": "context", "importance": 0.5, "validUntil": "2000-01-13T00:00:00+00:00", "supersededBy": "ylg1m5jvumr7lyi981cw", "createdAt": "2000-01-13T00:00:00+00:00", "source": "Robin Hood Compasses a Marriage", "entity": entity:["person", "edward"]};

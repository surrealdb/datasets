-- Pompeii election notices: SurrealDB Agent Memory showcase
-- What the SurrealDB Agent Memory API returned for this demo, as entities,
-- attributes and relations. It is the API's response shape, not the data
-- Agent Memory holds internally, which also includes embeddings, source
-- chunks and indexes. Relations are written as graph edges so they can be
-- traversed with ->relation->.

OPTION IMPORT;

DEFINE TABLE entity SCHEMALESS;
DEFINE TABLE attribute SCHEMALESS;
DEFINE TABLE relation TYPE RELATION FROM entity TO entity SCHEMALESS;
DEFINE INDEX attribute_entity ON attribute FIELDS entity;

